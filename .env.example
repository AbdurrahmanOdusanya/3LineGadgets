# ==============================================================================
# 3LINE GADGETS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE / PUBLIC CONFIGURATION (Exposed to browser)
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Public Anonymous API Key / Publishable Key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# Public Application URL (used for redirects, email auth confirmation links, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (CRITICAL: NEVER prefix with NEXT_PUBLIC_ or expose to client)
# ------------------------------------------------------------------------------
# Supabase Service Role Key: used strictly in server environments for elevated
# administrative operations, bypassing Row Level Security when strictly necessary.
# NEVER import or use this key on the client side!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Future Payment Provider (Paystack) - To be implemented in a subsequent feature
# PAYSTACK_SECRET_KEY="sk_test_..."
# PAYSTACK_PUBLIC_KEY="pk_test_..."
# PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"

# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted in AI Studio / Cloud Run
APP_URL="MY_APP_URL"

